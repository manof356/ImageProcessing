<Window x:Class="ImageProcessing.Dithering.DitheringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageProcessing.Dithering"
        mc:Ignorable="d"

        xmlns:wpfCommonParts="clr-namespace:ImageProcessing.wpfCommonParts"
        
        Title="Газетная обработка"
        Height="600" Width="800"
        MinHeight="600" MinWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <wpfCommonParts:BeforeAfterImages Grid.Row="0"
                                  OriginalImage="{Binding OriginalImage}"
                                  ResultImage="{Binding ResultImage}"/>
        <!--Грид для нижних кнопок-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!--Грид для загрузки и алгоритма-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <!--Кнопка загрузки фотографии-->
                <Button Name="LoadButton"
                        Content="Загрузить"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Padding="4"
                        Margin="4"
                        Command="{Binding LoadCommand}"/>
                <!--Групбокс для выбора алгоритма-->
                <GroupBox Grid.Row="1"
                          Header="Алгоритм"
                          Margin="2,2,4,2"
                          Padding="5">
                    <!--Грид для кнопок-->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <!--Кобобокс выбора алгоритма-->
                        <ComboBox Name="AlgorithmComboBox"
                                  Margin="4"
                                  SelectedIndex="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Флойда-Стейнберга"/>
                            <ComboBoxItem Content="Других пока нет"/>
                        </ComboBox>
                        <!--Кнопка "Применить"-->
                        <Button Name="ApplyAlgorithm" 
                            Grid.Row="1" 
                            Content="Применить"
                                Margin="4"
                                VerticalAlignment="Center"
                                Padding="4"/>


                    </Grid>
                </GroupBox>
            </Grid>
            
            <!--Групбокс для выбора цветов-->
            <GroupBox Name="ColourGroupBox"
                      Grid.Column="1"
                      Header="Цвета"
                      Margin="2,2,4,2"
                      Padding="5"/>
        </Grid>
        <Button Name="ExportButton"
                Content="Экспорт"
                Padding="4"
                Margin="14,0"
                Grid.Row="2" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding ExportCommand}"/>
        <!--Пока не активна-->
        <Button Name="KeepItButton"
                Content="Продолжить обработку"
                Padding="4"
                Margin="84,0"
                Grid.Row="2" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsEnabled="False"/>
    </Grid>
</Window>
