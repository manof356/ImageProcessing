<Window x:Class="ImageProcessing.BlackAndWhite.BlackAndWhiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageProcessing.BlackAndWhite"
        
        xmlns:MyControls="clr-namespace:ImageProcessing.MyControls"
        xmlns:wpfCommonParts="clr-namespace:ImageProcessing.wpfCommonParts"

        mc:Ignorable="d"
        Title="Черно-белая фотография"
        Height="600" Width="800"
        MinHeight="600" MinWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <wpfCommonParts:BeforeAfterImages Grid.Row="0"
                                          OriginalImage="{Binding OriginalImage}"
                                          ResultImage="{Binding ResultImage}"/>
        <!--Грид для слайдера-->
        <Grid Name="SliderGrid"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <!--Кнопка загрузки фотографии-->
            <Button Name="LoadButton"
                    Content="Загрузить"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="4"
                    Command="{Binding LoadCommand}"/>
            <!--Слайдер черно-белости-->
            <MyControls:SliderWithTextBlocks Grid.Column="1"
                                 LeftText=""
                                 Minimum="0"
                                 Maximum="100"
                                 Step="1"
                                 Value="{Binding Amount, Mode=TwoWay}"
                                 Margin="4">
            </MyControls:SliderWithTextBlocks>
        </Grid>
        <Button Name="ExportButton"
                Content="Экспорт"
                Padding="4"
                Margin="14,0"
                Grid.Row="2" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding ExportCommand}"/>
        <!--Пока не активна-->
        <Button Name="KeepItButton"
                Content="Продолжить обработку"
                Padding="4"
                Margin="84,0"
                Grid.Row="2" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsEnabled="False"/>
        
    </Grid>
</Window>
